<ui:FluentWindow xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" ExtendsContentIntoTitleBar="True" x:Class="AcousticLink.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:AcousticLink.App" xmlns:visual="clr-namespace:AcousticLink.App.Visualization" mc:Ignorable="d" Title="AcousticLink — Módem acústico BFSK / FDM" Height="740" Width="1180" MinHeight="600" MinWidth="820" Background="{StaticResource PageBrush}" Foreground="#E5EDF7" FontFamily="{StaticResource MainFont}" FontSize="14" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ui:TitleBar x:Name="WindowTitleBar" Title="AcousticLink" Height="36" Background="#101B2B" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="160,0,160,0">
      <TextBlock x:Name="ActiveSectionText" Text="Panel general" FontWeight="SemiBold" />
      <TextBlock Text=" · " Foreground="#8094AF"/><TextBlock Text="{Binding Text, ElementName=GeneralStateText}" FontSize="12" Foreground="#AABBD0"/>
    </StackPanel>
    <ui:NavigationView x:Name="WorkspaceNavigation" Grid.Row="1" Background="{StaticResource PageBrush}" HeaderVisibility="Collapsed" AlwaysShowHeader="False" FrameMargin="0" PaneDisplayMode="Left" IsPaneOpen="True" OpenPaneLength="184" CompactPaneLength="52" IsBackButtonVisible="Collapsed" IsPaneToggleVisible="True">
      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem Content="Panel general" Tag="0" Icon="{ui:SymbolIcon Home24}" Click="Navigation_Click" ToolTip="Panel general"/>
        <ui:NavigationViewItem Content="Emisor" Tag="1" Icon="{ui:SymbolIcon Send24}" Click="Navigation_Click" ToolTip="Emisor"/>
        <ui:NavigationViewItem Content="Receptor" Tag="2" Icon="{ui:SymbolIcon Mic24}" Click="Navigation_Click" ToolTip="Receptor"/>
        <ui:NavigationViewItem Content="Análisis" Tag="3" Icon="{ui:SymbolIcon Search24}" Click="Navigation_Click" ToolTip="Análisis"/>
        <ui:NavigationViewItem Content="Calibración" Tag="4" Icon="{ui:SymbolIcon Mic24}" Click="Navigation_Click" ToolTip="Calibración acústica"/>
      </ui:NavigationView.MenuItems>
      <ui:NavigationView.ContentOverlay>
    <TabControl x:Name="MainSectionsTabs" Margin="12,4,12,0" SelectionChanged="WorkspaceSection_Changed" Background="Transparent" BorderThickness="0" SelectedIndex="0">
      <TabControl.RenderTransform><TranslateTransform/></TabControl.RenderTransform>
      <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
      <TabItem Header="Panel general">
       <TabControl x:Name="DashboardTools" Background="Transparent" BorderThickness="0"><TabItem Header="Operaciones"><ScrollViewer x:Name="DashboardOperationScroll" Background="{StaticResource PageBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="4,8,12,8">
            <TextBlock Text="Panel general" Style="{StaticResource Heading}" Margin="0,0,0,2"/>
            <TextBlock Text="Prepará una transmisión y consultá el estado de la captura y los últimos resultados." Style="{StaticResource Caption}" Margin="0,0,0,8"/>
            <Border Style="{StaticResource TransmitterActionPanel}" Margin="0,0,0,8">
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Width="240" Margin="0,0,16,0">
                  <TextBlock Text="MODALIDAD DEL EMISOR" Style="{StaticResource TransmitterEyebrow}"/>
                  <ComboBox x:Name="DashboardModeComboBox" SelectedIndex="{Binding SelectedIndex, ElementName=TransmitModeComboBox, Mode=TwoWay}" IsEnabled="{Binding IsEnabled, ElementName=TransmitModeComboBox}"><ComboBoxItem Content="BFSK — Un canal"/><ComboBoxItem Content="FDM — Dos canales"/></ComboBox>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="ESTADO GENERAL / AUDIO" Style="{StaticResource TransmitterEyebrow}"/>
                  <TextBlock Text="{Binding Text, ElementName=GeneralStateText}" FontWeight="SemiBold"/>
                  <TextBlock Text="La reproducción local y la captura no confirman un enlace entre equipos." Style="{StaticResource Caption}"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <TextBlock Text="EMISOR  ·  MENSAJES" Style="{StaticResource TransmitterEyebrow}" Margin="0,0,0,4"/>
              <Grid x:Name="DashboardTransmitGrid" SizeChanged="DashboardLayout_SizeChanged">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="16" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Border x:Name="DashboardTransmitACard" Grid.Column="0" Style="{StaticResource OperationPanel}" BorderBrush="{StaticResource ChannelABrush}" Margin="0,0,0,8">
                <StackPanel>
                  <TextBlock Text="CANAL A" Foreground="{StaticResource ChannelABrush}" FontWeight="Bold" />
                  <TextBlock Text="1200 / 1900 Hz · 1–8 bytes UTF-8" Style="{StaticResource Caption}" Margin="0,4,0,12" />
                  <TextBox Text="{Binding Text, ElementName=FdmTextATextBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=FdmTextATextBox}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource OperationPanel}" BorderBrush="{StaticResource ChannelBBrush}" Visibility="{Binding Visibility, ElementName=TransmitChannelBPanel}" Margin="0,0,0,8">
                <StackPanel>
                  <TextBlock Text="CANAL B" Foreground="{StaticResource ChannelBBrush}" FontWeight="Bold" />
                  <TextBlock Text="3000 / 3700 Hz · 1–8 bytes UTF-8" Style="{StaticResource Caption}" Margin="0,4,0,12" />
                  <TextBox Text="{Binding Text, ElementName=FdmTextBTextBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=FdmTextBTextBox}" />
                </StackPanel>
              </Border>
            </Grid>
<Grid x:Name="DashboardSecondaryGrid" SizeChanged="DashboardLayout_SizeChanged"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>            <Border x:Name="DashboardConfiguration" Style="{StaticResource OperationPanel}">
              <StackPanel>
                <TextBlock Text="{Binding Text, ElementName=TransmitConfigurationTitle}" FontWeight="SemiBold" />
                <ui:ToggleSwitch Content="Usar Hamming (7,4)" Margin="0,8" IsChecked="{Binding IsChecked, ElementName=UseHammingTransmitCheckBox, Mode=TwoWay}" IsEnabled="{Binding IsEnabled, ElementName=UseHammingTransmitCheckBox}" />
                <TextBlock Text="{Binding Text, ElementName=TransmitModeSummaryText}" Style="{StaticResource Caption}" />
                <ComboBox ItemsSource="{Binding ItemsSource, ElementName=FdmProfileComboBox}" SelectedItem="{Binding SelectedItem, ElementName=FdmProfileComboBox, Mode=TwoWay}" IsEnabled="{Binding IsEnabled, ElementName=FdmProfileComboBox}" Visibility="{Binding Visibility, ElementName=FdmProfilePanel}" Margin="0,10" />
                <Expander Header="Composición de las tramas"><TextBlock Text="{Binding Text, ElementName=FdmTextInfoText}" /></Expander><TextBlock Text="{Binding Text, ElementName=TransmitDurationText}" FontSize="20" Margin="0,8,0,0"/>
                <Button Content="Transmitir mensajes" Style="{StaticResource Primary}" Margin="0,14,0,0" Click="TransmitFdmText_Click" IsEnabled="{Binding IsEnabled, ElementName=TransmitFdmTextButton}" />
                <TextBlock Text="{Binding Text, ElementName=FdmTextStatusText}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
              </StackPanel>
            </Border>
<Border x:Name="DashboardSignalCard" Grid.Column="2" Style="{StaticResource OperationPanel}"><StackPanel><TextBlock Text="RECEPTOR  ·  CAPTURA" Style="{StaticResource TransmitterEyebrow}"/><TextBlock Text="{Binding Text, ElementName=GeneralStateText}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Text, ElementName=ContinuousStatusText}" Style="{StaticResource Caption}" Margin="0,4,0,4"/><TextBlock Text="{Binding SelectedItem.Content, ElementName=ReceiverModeComboBox, StringFormat='Análisis seleccionado: {0}'}" Style="{StaticResource Caption}"/><TextBlock Text="La actividad del micrófono no confirma una trama válida." Style="{StaticResource Caption}"/><Expander Header="Vista breve de la señal" Margin="0,8,0,8"><visual:SignalMiniView x:Name="MiniSignalMonitor" Margin="0,8"/></Expander><Button Content="Abrir monitor de señales" Click="OpenSignalMonitor_Click" Margin="0,0,0,12"/>
            <TextBlock Text="ÚLTIMO RESULTADO MOSTRADO" Style="{StaticResource TransmitterEyebrow}"/>
            <TextBlock Text="Puede ser histórico; comprobá el origen y CRC en Receptor." Style="{StaticResource Caption}" Margin="0,0,0,8"/>
            <Grid x:Name="DashboardReceptionGrid" SizeChanged="DashboardLayout_SizeChanged">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="16" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Border x:Name="DashboardReceptionACard" Grid.Column="0" Style="{StaticResource OperationPanel}" BorderBrush="{StaticResource ChannelABrush}">
                <StackPanel>
                  <TextBlock Text="RECEPCIÓN A" Foreground="{StaticResource ChannelABrush}" />
                  <TextBlock Text="{Binding SummaryText, ElementName=ReceptionAView}" Style="{StaticResource Caption}" />
                </StackPanel>
              </Border>
              <Border x:Name="DashboardReceptionBCard" Grid.Column="2" Style="{StaticResource OperationPanel}" BorderBrush="{StaticResource ChannelBBrush}" Visibility="{Binding Visibility, ElementName=ReceptionChannelBPanel}">
                <StackPanel>
                  <TextBlock Text="RECEPCIÓN B" Foreground="{StaticResource ChannelBBrush}" />
                  <TextBlock Text="{Binding SummaryText, ElementName=ReceptionBView}" Style="{StaticResource Caption}" />
                </StackPanel>
              </Border>
            </Grid></StackPanel></Border></Grid>
          </StackPanel>
        </ScrollViewer></TabItem><TabItem Header="Monitor de señales"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Border Style="{StaticResource TransmitterActionPanel}" Margin="4,4,4,8"><StackPanel><TextBlock Text="Monitor de señales" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Elegí la fuente antes de interpretar onda y energías. El audio observado no implica una trama válida; la señal digital no demuestra recepción acústica." Style="{StaticResource Caption}" Margin="0,3,0,8"/><WrapPanel><ComboBox x:Name="MonitorSourceComboBox" Width="260" SelectedIndex="0" SelectionChanged="MonitorSource_Changed" Margin="0,0,8,6"><ComboBoxItem Content="Audio observado · micrófono / WAV"/><ComboBoxItem Content="Última señal digital generada"/></ComboBox><Button Content="Analizar / reintentar" Click="AnalyzeMonitor_Click" Margin="0,0,8,6"/><Button x:Name="CancelMonitorButton" Content="Cancelar monitor" Click="CancelMonitor_Click" IsEnabled="False" Margin="0,0,0,6"/></WrapPanel></StackPanel></Border><visual:SignalMonitorView x:Name="DashboardSignalMonitor" Grid.Row="1"/></Grid></TabItem></TabControl>
      </TabItem>
      <TabItem Header="Emisor">
        <Grid x:Name="TransmitterWorkspace" Background="{StaticResource PageBrush}">
          <TabControl x:Name="TransmitterTools" Background="Transparent" BorderThickness="0">
            <TabItem Header="Mensajes de texto">
              <Grid x:Name="TransmitPanels" Margin="8,4,8,8" SizeChanged="TransmitPanels_SizeChanged">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="4,0,4,10">
                  <TextBlock Text="Preparar mensaje" Style="{StaticResource Heading}" Margin="0,0,0,2"/>
                  <TextBlock Text="Elegí la modalidad, revisá la trama digital y transmití por la salida de audio." Style="{StaticResource Caption}"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <Grid x:Name="TransmitContentGrid" Margin="4,0,12,8">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="TransmitMessageColumn" Width="1.2*"/><ColumnDefinition x:Name="TransmitColumnGap" Width="14"/><ColumnDefinition x:Name="TransmitDetailsColumn" Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel x:Name="TransmitMessagePanel" Grid.Column="0">
                      <Border Style="{StaticResource TransmitterPanel}"><StackPanel>
                        <TextBlock Text="01  MODALIDAD" Style="{StaticResource TransmitterEyebrow}"/>
                        <ComboBox x:Name="TransmitModeComboBox" SelectedIndex="1" HorizontalAlignment="Stretch" SelectionChanged="TransmitMode_Changed" Margin="0,4,0,6"><ComboBoxItem Content="BFSK — Un canal"/><ComboBoxItem Content="FDM — Dos canales"/></ComboBox>
                        <TextBlock x:Name="TransmitModeDescription" Text="Dos mensajes en canales simultáneos" Style="{StaticResource Caption}"/>
                      </StackPanel></Border>
                      <Border Style="{StaticResource TransmitterPanel}"><StackPanel>
                        <TextBlock Text="02  MENSAJES" Style="{StaticResource TransmitterEyebrow}"/>
                        <TextBlock Text="Hasta 8 bytes UTF-8 por canal; un carácter puede ocupar más de un byte." Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                        <TextBlock Text="Canal A · 1200 / 1900 Hz" Foreground="{StaticResource ChannelABrush}" FontSize="17" FontWeight="SemiBold"/>
                        <TextBox x:Name="FdmTextATextBox" Text="Hola" HorizontalAlignment="Stretch" FontSize="22" Margin="0,7,0,4" TextChanged="FdmText_TextChanged" AutomationProperties.Name="Mensaje canal A"/>
                        <TextBlock x:Name="TransmitABytesText" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        <StackPanel x:Name="TransmitChannelBPanel" Margin="0,14,0,0">
                          <Separator Margin="0,0,0,12" Background="{StaticResource LineBrush}"/>
                          <TextBlock Text="Canal B · 3000 / 3700 Hz" Foreground="{StaticResource ChannelBBrush}" FontSize="17" FontWeight="SemiBold"/>
                          <TextBox x:Name="FdmTextBTextBox" Text="Mundo" HorizontalAlignment="Stretch" FontSize="22" Margin="0,7,0,4" TextChanged="FdmText_TextChanged" AutomationProperties.Name="Mensaje canal B"/>
                          <TextBlock x:Name="TransmitBBytesText" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                        </StackPanel>
                      </StackPanel></Border>
                      <Border Style="{StaticResource TransmitterPanel}"><StackPanel>
                        <TextBlock Text="EXPLORAR LA SEÑAL" Style="{StaticResource TransmitterEyebrow}"/>
                        <TextBlock Text="Preparar construye un buffer digital sin reproducir sonido. Explorar abre la última señal disponible; puede corresponder a un mensaje anterior." Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                        <WrapPanel><Button Content="Preparar vista previa" Click="PrepareSignalPreview_Click" Margin="0,0,8,8"/><Button Content="Explorar última señal" Click="OpenGeneratedMonitor_Click" Margin="0,0,8,8"/><Button Content="Guardar WAV digital" Click="SaveGeneratedWav_Click" Margin="0,0,0,8" ToolTip="Exporta las muestras digitales disponibles; no graba el micrófono."/></WrapPanel>
                      </StackPanel></Border>
                    </StackPanel>
                    <StackPanel x:Name="TransmitDetailsPanel" Grid.Column="2">
                      <Border Style="{StaticResource TransmitterPanel}"><StackPanel>
                        <TextBlock x:Name="TransmitConfigurationTitle" Text="CONFIGURACIÓN FDM" Style="{StaticResource TransmitterEyebrow}"/>
                        <StackPanel x:Name="FdmProfilePanel"><TextBlock Text="Perfil de amplitud" Margin="0,0,0,4"/><ComboBox x:Name="FdmProfileComboBox" Style="{StaticResource InspectorSelector}" SelectionChanged="WalkthroughProfile_Changed" Margin="0,0,0,12"/></StackPanel>
                        <ui:ToggleSwitch x:Name="UseHammingTransmitCheckBox" Content="Usar Hamming (7,4)" IsChecked="False" Checked="HammingTransmit_Changed" Unchecked="HammingTransmit_Changed"/>
                        <TextBlock Text="Hamming corrige ciertos errores del bloque; la cabecera queda fuera. Seleccioná la misma opción en el receptor." Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                      </StackPanel></Border>
                      <Border Style="{StaticResource TransmitterPanel}"><StackPanel>
                        <TextBlock Text="03  TRAMA CALCULADA" Style="{StaticResource TransmitterEyebrow}"/>
                        <TextBlock Text="Bytes, bits y símbolos derivados de los mensajes y opciones." Style="{StaticResource Caption}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="FdmTextInfoText" TextWrapping="Wrap" FontSize="13"/>
                        <Separator Margin="0,12" Background="{StaticResource LineBrush}"/>
                        <TextBlock x:Name="TransmitModeSummaryText" Text="CRC-32 permanente · FDM de dos canales · 48 kHz · 0,10 s/símbolo" Style="{StaticResource Caption}"/>
                        <TextBlock x:Name="TransmitPaddingNote" Text="Cabecera sin Hamming. El relleno FDM queda fuera del CRC y del bloque protegido." Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                        <TextBlock Text="CRC-32 comprueba integridad al recibir; no corrige errores." Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                      </StackPanel></Border>
                    </StackPanel>
                  </Grid>
                </ScrollViewer>
                <Border Grid.Row="2" Style="{StaticResource TransmitterActionPanel}" Margin="4,8,4,0">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                      <TextBlock Text="DURACIÓN DIGITAL PREVISTA" Style="{StaticResource TransmitterEyebrow}"/>
                      <TextBlock x:Name="TransmitDurationText" FontSize="20" FontWeight="SemiBold"/>
                      <TextBlock x:Name="FdmTextStatusText" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button x:Name="TransmitFdmTextButton" Grid.Column="1" Content="Transmitir audio" Style="{StaticResource Primary}" FontSize="17" Padding="26,12" VerticalAlignment="Center" Click="TransmitFdmText_Click"/>
                  </Grid>
                </Border>
              </Grid>
            </TabItem>
            <TabItem Header="Pruebas técnicas"><TabControl Background="Transparent" BorderThickness="0"><TabItem Header="BFSK · pruebas" ToolTip="Tonos, secuencia y trama BFSK"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,6,12,8">
                        <TextBlock Text="Laboratorio BFSK" Style="{StaticResource Heading}" Margin="0,0,0,2"/>
                        <TextBlock Text="Pruebas independientes del envío de mensajes. Un tono aislado no es una trama." Style="{StaticResource Caption}" Margin="0,0,0,16"/>
                      <Grid x:Name="BfskTechnicalGrid" SizeChanged="TechnicalLayout_SizeChanged">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource TransmitterPanel}" BorderBrush="{StaticResource ChannelABrush}"><StackPanel>
                        <TextBlock Margin="0,0,0,8" Foreground="{StaticResource ChannelABrush}" FontSize="17" FontWeight="SemiBold" Text="01  Tonos aislados" />
                        <Button x:Name="Bit0Button" Content="Reproducir bit 0 (1200 Hz)" Margin="0,0,0,12" Padding="12" Click="PlayBit0_Click" />
                        <Button x:Name="Bit1Button" Content="Reproducir bit 1 (1900 Hz)" Padding="12" Click="PlayBit1_Click" />
                        </StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource TransmitterPanel}" BorderBrush="{StaticResource ChannelABrush}"><StackPanel>
                        <TextBlock Margin="0,0,0,8" Foreground="{StaticResource ChannelABrush}" FontSize="17" FontWeight="SemiBold" Text="02  Secuencia BFSK" />
                        <TextBox x:Name="BitSequenceTextBox" Padding="8" Text="10110010" TextChanged="BitSequenceTextBox_TextChanged" />
                        <TextBlock x:Name="SequenceInfoText" Margin="0,6,0,10" Text="8 bits · duración estimada: 0,8 s" />
                        <Button x:Name="PlaySequenceButton" Content="Reproducir secuencia BFSK" Padding="12" Click="PlaySequence_Click" />
                        </StackPanel></Border>
                        <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource TransmitterPanel}" BorderBrush="{StaticResource ChannelABrush}"><StackPanel>
                        <TextBlock Margin="0,0,0,8" Foreground="{StaticResource ChannelABrush}" FontSize="17" FontWeight="SemiBold" Text="03  Trama de prueba · datos de 1–16 bits" />
                        <TextBlock x:Name="FrameInfoText" TextWrapping="Wrap" />
                        <Button x:Name="PlayFrameButton" Content="Reproducir trama de prueba" Padding="12" Margin="0,8,0,0" Click="PlayFrame_Click" />
                        <TextBlock x:Name="StatusText" Margin="0,16,0,0" TextWrapping="Wrap" Text="Tonos de prueba: 1 segundo, amplitud 0,15." />
                        </StackPanel></Border>
                      </Grid>
                    </StackPanel>
                  </ScrollViewer></TabItem>
<TabItem Header="FDM · tonos"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,6,12,8">
                        <TextBlock Text="Tonos FDM" Style="{StaticResource Heading}" Margin="0,0,0,2"/>
                        <TextBlock Text="Los canales A y B se reproducen simultáneamente durante 1 segundo." Style="{StaticResource Caption}" Margin="0,0,0,16"/>
                      <Grid x:Name="FdmTonesGrid" SizeChanged="TechnicalLayout_SizeChanged">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource TransmitterPanel}" BorderBrush="{StaticResource ChannelABrush}"><StackPanel>
                        <TextBlock Text="Canal A · 1200 / 1900 Hz" Foreground="{StaticResource ChannelABrush}" FontWeight="SemiBold" />
                        <ComboBox x:Name="FdmBitAComboBox" SelectedIndex="0" Margin="0,4,0,8">
                          <ComboBoxItem Content="Bit 0 · 1200 Hz" />
                          <ComboBoxItem Content="Bit 1 · 1900 Hz" />
                        </ComboBox>
                        </StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource TransmitterPanel}" BorderBrush="{StaticResource ChannelBBrush}"><StackPanel>
                        <TextBlock Text="Canal B · 3000 / 3700 Hz" Foreground="{StaticResource ChannelBBrush}" FontWeight="SemiBold" />
                        <ComboBox x:Name="FdmBitBComboBox" SelectedIndex="0" Margin="0,4,0,8">
                          <ComboBoxItem Content="Bit 0 · 3000 Hz" />
                          <ComboBoxItem Content="Bit 1 · 3700 Hz" />
                        </ComboBox>
                        </StackPanel></Border>
                        <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource TransmitterActionPanel}"><StackPanel>
                        <TextBlock Text="MEZCLA SIMULTÁNEA" Style="{StaticResource TransmitterEyebrow}"/>
                        <TextBlock Text="Amplitudes según perfil · límite teórico conjunto: 0,15 · mono, 48 kHz" Style="{StaticResource Caption}" />
                        <Button x:Name="PlayFdmButton" Content="Reproducir ambos tonos" Padding="12" Margin="0,8,0,0" Click="PlayFdm_Click" />
                        <TextBlock x:Name="FdmStatusText" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                        </StackPanel></Border>
                      </Grid>
                    </StackPanel>
                  </ScrollViewer></TabItem>
<TabItem Header="FDM · secuencias"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,6,12,8">
                        <TextBlock Text="Secuencias FDM" Style="{StaticResource Heading}" Margin="0,0,0,2"/>
                        <TextBlock Text="Dos secuencias simultáneas, de igual longitud (1–16 bits)." Style="{StaticResource Caption}" Margin="0,0,0,16"/>
                      <Grid x:Name="FdmSequencesGrid" SizeChanged="TechnicalLayout_SizeChanged">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource TransmitterPanel}" BorderBrush="{StaticResource ChannelABrush}"><StackPanel>
                        <TextBlock Text="Bits del canal A · 1200 / 1900 Hz" Foreground="{StaticResource ChannelABrush}" FontWeight="SemiBold" />
                        <TextBox x:Name="FdmSequenceATextBox" Text="10110010" Padding="8" TextChanged="FdmSequences_TextChanged" />
                        </StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource TransmitterPanel}" BorderBrush="{StaticResource ChannelBBrush}"><StackPanel>
                        <TextBlock Text="Bits del canal B · 3000 / 3700 Hz" Foreground="{StaticResource ChannelBBrush}" FontWeight="SemiBold" />
                        <TextBox x:Name="FdmSequenceBTextBox" Text="01001101" Padding="8" TextChanged="FdmSequences_TextChanged" />
                        </StackPanel></Border>
                        <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource TransmitterActionPanel}"><StackPanel>
                        <TextBlock Text="REPRODUCCIÓN SIMULTÁNEA" Style="{StaticResource TransmitterEyebrow}"/>
                        <TextBlock x:Name="FdmSequencesInfoText" TextWrapping="Wrap" />
                        <Button x:Name="PlayFdmSequencesButton" Content="Reproducir ambas secuencias" Padding="12" Margin="0,8,0,0" Click="PlayFdmSequences_Click" />
                        <TextBlock x:Name="FdmSequencesStatusText" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                        </StackPanel></Border>
                      </Grid>
                    </StackPanel>
                  </ScrollViewer></TabItem>
<TabItem Header="FDM · tramas"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8,6,12,8">
                        <TextBlock Text="Tramas FDM" Style="{StaticResource Heading}" Margin="0,0,0,2"/>
                        <TextBlock Text="Dos tramas completas simultáneas; los datos de prueba tienen igual longitud (1–16 bits)." Style="{StaticResource Caption}" Margin="0,0,0,16"/>
                      <Grid x:Name="FdmFramesGrid" SizeChanged="TechnicalLayout_SizeChanged">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource TransmitterPanel}" BorderBrush="{StaticResource ChannelABrush}"><StackPanel>
                        <TextBlock Text="Datos A" Foreground="{StaticResource ChannelABrush}" FontWeight="SemiBold" />
