 <TabItem Header="Herramientas manuales"><ScrollViewer VerticalScrollBarVisibility="Auto"><Expander Header="Herramientas de diagnóstico manual"><Border Style="{StaticResource Card}"><StackPanel><Expander Header="Tono BFSK"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Margin="0,24,0,8" FontWeight="SemiBold" Text="Analizar tono BFSK · ventana de 0,10 s" /><TextBlock Text="Instante inicial de la ventana (segundos):" /><TextBox x:Name="AnalysisStartTextBox" Text="0" Padding="8" /><Button x:Name="AnalyzeToneButton" Content="Analizar grabación finalizada" IsEnabled="False" Padding="8" Margin="0,8,0,0" Click="AnalyzeTone_Click" /><TextBlock x:Name="AnalysisResultText" TextWrapping="Wrap" Margin="0,8,0,0" Text="Sin análisis." /></StackPanel></Border></Expander><Expander Header="Secuencia BFSK"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Margin="0,24,0,8" FontWeight="SemiBold" Text="Decodificar secuencia · inicio manual · 0,10 s por bit" /><TextBlock Text="Inicio del primer bit (segundos, admite centésimas o más decimales):" /><TextBox x:Name="SequenceStartTextBox" Text="0" Padding="8" /><TextBlock Text="Cantidad esperada de bits (1–64):" Margin="0,8,0,0" /><TextBox x:Name="SequenceBitCountTextBox" Text="8" Padding="8" /><Button x:Name="DecodeSequenceButton" Content="Analizar secuencia grabada" IsEnabled="False" Padding="8" Margin="0,8,0,0" Click="DecodeSequence_Click" /><TextBlock x:Name="DecodedSequenceText" Text="Sin decodificación." TextWrapping="Wrap" Margin="0,8,0,0" /><TextBox x:Name="SequenceDiagnosticsText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="200" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" /></StackPanel></Border></Expander><Expander Header="Sincronización BFSK"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Margin="0,24,0,8" FontWeight="SemiBold" Text="Sincronización automática" /><TextBlock Text="Cantidad esperada de bits de datos (1–16):" /><TextBox x:Name="SyncBitCountTextBox" Text="8" Padding="8" /><Button x:Name="SynchronizeButton" Content="Buscar y decodificar trama" IsEnabled="False" Padding="8" Margin="0,8,0,0" Click="Synchronize_Click" /><TextBlock x:Name="SynchronizationText" Text="Sin búsqueda." TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel></Border></Expander><Expander Header="Tono FDM"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Margin="0,24,0,8" FontWeight="SemiBold" Text="Detección FDM" /><TextBlock Text="Inicio de la ventana de 0,10 s (segundos):" /><TextBox x:Name="FdmAnalysisStartTextBox" Text="0" Padding="8" /><Button x:Name="AnalyzeFdmButton" Content="Analizar ambos canales" IsEnabled="False" Padding="8" Margin="0,8,0,0" Click="AnalyzeFdm_Click" /><TextBlock x:Name="FdmDetectionText" Text="Sin análisis FDM." TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel></Border></Expander><Expander Header="Secuencia FDM"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Margin="0,24,0,8" FontWeight="SemiBold" Text="Decodificación FDM" /><TextBlock Text="Última grabación finalizada · inicio común manual (segundos):" /><TextBox x:Name="FdmDecodeStartTextBox" Text="0" Padding="8" /><TextBlock Text="Símbolos esperados por canal (1–16):" Margin="0,8,0,0" /><TextBox x:Name="FdmDecodeCountTextBox" Text="8" Padding="8" /><CheckBox x:Name="FdmDecodeFramesCheckBox" Content="Incluir cabeceras de trama (la cantidad indicada corresponde a datos)" Margin="0,8,0,0" /><Button x:Name="DecodeFdmButton" Content="Decodificar ambas secuencias" IsEnabled="False" Padding="8" Margin="0,8,0,0" Click="DecodeFdm_Click" /><TextBlock x:Name="FdmDecodedText" Text="Sin decodificación FDM." TextWrapping="Wrap" Margin="0,8,0,0" /><TextBox x:Name="FdmDiagnosticsText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="200" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" /></StackPanel></Border></Expander><Expander Header="Sincronización FDM"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Margin="0,24,0,8" FontWeight="SemiBold" Text="Sincronización automática FDM" /><TextBlock Text="Última grabación finalizada · bits de datos por canal (1–16):" /><TextBox x:Name="FdmSyncCountTextBox" Text="8" Padding="8" /><Button x:Name="SynchronizeFdmButton" Content="Buscar ambas tramas" IsEnabled="False" Padding="8" Margin="0,8,0,0" Click="SynchronizeFdm_Click" /><Button x:Name="CancelFdmSyncButton" Content="Cancelar búsqueda FDM" IsEnabled="False" Padding="8" Margin="0,8,0,0" Click="CancelFdmSync_Click" /><TextBlock x:Name="FdmSyncResultText" Text="Sin búsqueda FDM." TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel></Border></Expander></StackPanel></Border></Expander></ScrollViewer></TabItem>
</TabControl></TabItem>

<TabItem Header="Comparación"><Grid x:Name="ComparisonWorkspace" Background="{StaticResource PageBrush}" Margin="4" SizeChanged="ComparisonWorkspace_SizeChanged"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <ScrollViewer x:Name="ComparisonSettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="8,4,14,4">
  <TextBlock Text="CONFIGURAR ENSAYO" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
  <TextBlock Text="Fuente, referencia declarada y condiciones del procesamiento" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
  <WrapPanel Margin="0,0,0,8"><Button x:Name="ComparisonRunButton" Content="Ejecutar" Style="{StaticResource Primary}" Click="ComparisonRun_Click" Padding="12,6" Margin="0,0,5,0"/><Button x:Name="ComparisonCancelButton" Content="Cancelar" Click="ComparisonCancel_Click" IsEnabled="False" Padding="12,6"/></WrapPanel>
  <TextBlock Text="Identificador de serie"/><TextBox x:Name="ComparisonIdText" Text="serie-1"/>
  <TextBlock Text="Fuente" Margin="0,8,0,0"/><ComboBox x:Name="ComparisonSourceCombo" SelectedIndex="0" SelectionChanged="ComparisonSource_Changed"><ComboBoxItem Content="Generada · par BFSK/FDM"/><ComboBoxItem Content="Audio seleccionado · WAV/micrófono"/></ComboBox>
  <TextBlock x:Name="ComparisonSelectedAudioText" Text="Fuente actual: señal digital generada" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
  <TextBlock Text="Modalidad del audio seleccionado" Margin="0,8,0,0"/><ComboBox x:Name="ComparisonModeCombo" SelectedIndex="0"><ComboBoxItem Content="BFSK"/><ComboBoxItem Content="FDM"/></ComboBox>
  <CheckBox x:Name="ComparisonReferenceCheck" Content="Conozco los textos transmitidos" IsChecked="True" Margin="0,8,0,0"/>
  <TextBlock Text="Texto A (1–8 bytes UTF-8)" Margin="0,8,0,0"/><TextBox x:Name="ComparisonAText" Text="Hola"/>
  <TextBlock Text="Texto B (FDM o par generado)" Margin="0,8,0,0"/><TextBox x:Name="ComparisonBText" Text="Mundo"/>
  <CheckBox x:Name="ComparisonHammingCheck" Content="Hamming (7,4)" Margin="0,10,0,0" Checked="ComparisonSource_Changed" Unchecked="ComparisonSource_Changed"/>
  <CheckBox x:Name="ComparisonErasureCheck" Content="Recuperar borrados (audio seleccionado)"/>
  <TextBlock Text="Perfil FDM generado / declarado" Margin="0,8,0,0"/><ComboBox x:Name="ComparisonProfileCombo"/>
  <TextBlock Text="SNR de ruido blanco digital (dB)" Margin="0,8,0,0"/><TextBox x:Name="ComparisonSnrText" ToolTip="Vacío = sin ruido añadido. Entre 0 y 60 dB."/>
  <TextBlock Text="Semilla" Margin="0,8,0,0"/><TextBox x:Name="ComparisonSeedText" Text="42"/>
  <TextBlock Text="Repeticiones (1–10)" Margin="0,8,0,0"/><TextBox x:Name="ComparisonRepeatText" Text="1"/>
  <TextBlock x:Name="ComparisonStatusText" Text="Sin ensayos en esta sesión." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,8"/>
  <Separator Margin="0,8,0,12"/>
  <TextBlock Text="HISTORIAL Y EXPORTACIÓN" FontWeight="SemiBold" Margin="0,0,0,8"/>
  <WrapPanel><Button Content="Guardar historial" Click="ComparisonSave_Click" Padding="8,5" Margin="0,0,4,4"/><Button Content="Abrir historial" Click="ComparisonLoad_Click" Padding="8,5" Margin="0,0,4,4"/><Button Content="Exportar CSV" Click="ComparisonCsv_Click" Padding="8,5" Margin="0,0,4,4"/></WrapPanel>
  <TextBlock Text="Historial de ensayos (seleccionar dos para comparar)" TextWrapping="Wrap" Margin="0,8,0,4"/><ListBox x:Name="ComparisonHistoryList" Height="210" SelectionMode="Extended" SelectionChanged="ComparisonHistory_Changed" DisplayMemberPath="Id"/>
 </StackPanel></ScrollViewer>
 <ScrollViewer x:Name="ComparisonResultsScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="10,4,8,4">
  <TextBlock Text="RESULTADOS BFSK / FDM" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
  <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,8"><StackPanel><TextBlock Text="COMPARABILIDAD" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ComparisonCompatibilityText" Text="Seleccioná ensayos del historial." TextWrapping="Wrap" Foreground="#FFCE75" Margin="0,4,0,0"/></StackPanel></Border>
  <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,8"><StackPanel><TextBlock Text="RESUMEN DE LOS ENSAYOS SELECCIONADOS" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ComparisonSummaryText" Text="Sin resultados." TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
  <Expander Header="Detalle por canal y límites de interpretación" Margin="0,0,0,8"><Border Style="{StaticResource Card}" Padding="12,8"><TextBlock x:Name="ComparisonDetailsText" Text="Seleccioná un ensayo para consultar el detalle." TextWrapping="Wrap"/></Border></Expander>
  <Expander Header="Gráficos de métricas · resultados disponibles" IsExpanded="True" Margin="0,0,0,8"><StackPanel x:Name="ComparisonCharts"/></Expander>
  <Expander Header="Espectro relativo · Hz / dB respecto del máximo" IsExpanded="True"><StackPanel><TextBlock Text="Escala relativa de cada ensayo; no es SNR medida." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/><StackPanel x:Name="ComparisonSpectrumCharts"/></StackPanel></Expander>
  <TextBlock Text="Historial: cada fila es un ensayo. Los resúmenes agregados indican n; el CSV distingue canal y total. Latencia acústica: No disponible." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
 </StackPanel></ScrollViewer>
</Grid></TabItem>

  </TabControl>
 </Grid>
</Grid></TabItem>
      <TabItem Header="Calibración acústica">
        <Grid x:Name="CalibrationWorkspace" Background="{StaticResource PageBrush}" Margin="4,2,4,4" SizeChanged="CalibrationWorkspace_SizeChanged">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="420"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border x:Name="CalibrationQuickActions" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{StaticResource ResultSurfaceBrush}" Padding="8,5" Margin="8,0,8,4" CornerRadius="6"><WrapPanel VerticalAlignment="Center">
            <TextBlock Text="RECEPTOR · " FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Width="80" SelectedIndex="{Binding SelectedIndex, ElementName=CalibrationNoiseDuration, Mode=TwoWay}" Margin="0,0,6,0"><ComboBoxItem Content="5 s"/><ComboBoxItem Content="10 s"/><ComboBoxItem Content="20 s"/></ComboBox>
            <Button Content="1 · Referencia" Click="CalibrationNoise_Click" IsEnabled="{Binding IsEnabled, ElementName=CalibrationNoiseButton}" Style="{StaticResource Primary}" Padding="9,5" Margin="0,0,6,0"/>
            <Button Content="2 · Prueba (tras referencia)" Click="CalibrationCapture_Click" IsEnabled="{Binding IsEnabled, ElementName=CalibrationCaptureButton}" Style="{StaticResource Primary}" Padding="9,5"/>
          </WrapPanel></Border>
          <ScrollViewer x:Name="CalibrationStepsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="8,4,12,8">
            <TextBlock Text="Calibración acústica" Style="{StaticResource Heading}" Margin="0,0,0,4"/>
            <TextBlock Text="Primero ruido; después señal conocida entre dos equipos." Style="{StaticResource Caption}" Margin="0,0,0,8"/>
            <Border Style="{StaticResource OperationPanel}"><StackPanel>
              <TextBlock Text="01  PREPARAR LOS EQUIPOS" FontWeight="SemiBold" Foreground="{StaticResource ChannelABrush}" Margin="0,0,0,6"/>
              <TextBlock Text="En el receptor: parlante del emisor frente al micrófono. Mantené distancia, volumen y ganancia; evitá loopback." Style="{StaticResource Caption}" Margin="0,0,0,6"/>
              <TextBlock Text="Modalidad"/><ComboBox x:Name="CalibrationModeCombo" SelectedIndex="0" SelectionChanged="CalibrationMode_Changed" Margin="0,4,0,8"><ComboBoxItem Content="BFSK · canal A"/><ComboBoxItem Content="FDM · canales A y B"/></ComboBox>
              <TextBlock x:Name="CalibrationFrequenciesText" Style="{StaticResource Caption}" Text="Canal A: 1200 y 1900 Hz · salida digital 48 kHz" Margin="0,0,0,8"/>
              <TextBlock Text="Micrófono y condiciones declaradas"/><TextBox x:Name="CalibrationDeviceText" TextChanged="CalibrationDevice_Changed" Margin="0,4,0,0" ToolTip="Nombre del micrófono de Windows, posición y ganancia. La aplicación no verifica la identidad del dispositivo."/>
              <TextBlock Text="Entrada predeterminada de Windows · identificación manual" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource OperationPanel}"><StackPanel>
              <TextBlock Text="02  REFERENCIA DE RUIDO" FontWeight="SemiBold" Foreground="{StaticResource ChannelABrush}" Margin="0,0,0,6"/>
              <TextBlock Text="Sin emisión intencional en el receptor." Style="{StaticResource Caption}" Margin="0,0,0,6"/>
              <StackPanel Orientation="Horizontal"><ComboBox x:Name="CalibrationNoiseDuration" SelectedIndex="0" Width="90" Margin="0,0,8,0"><ComboBoxItem Content="5 s" Tag="5"/><ComboBoxItem Content="10 s" Tag="10"/><ComboBoxItem Content="20 s" Tag="20"/></ComboBox><Button x:Name="CalibrationNoiseButton" Content="Capturar referencia" Click="CalibrationNoise_Click" Style="{StaticResource Primary}"/></StackPanel>
              <TextBlock x:Name="CalibrationNoiseStepText" Text="Pendiente · comenzá aquí" Foreground="{StaticResource WarningBrush}" Margin="0,7,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource OperationPanel}"><StackPanel>
              <TextBlock Text="03  SEÑAL CONOCIDA" FontWeight="SemiBold" Foreground="{StaticResource ChannelBBrush}" Margin="0,0,0,6"/>
              <TextBlock Text="Primero iniciá la captura en el receptor; después emití una vez desde el otro equipo. Esperá a que termine. No hay sincronización automática." Style="{StaticResource Caption}" Margin="0,0,0,8"/>
              <TextBlock Text="RECEPTOR · audio capturado" FontWeight="SemiBold"/><Button x:Name="CalibrationCaptureButton" Content="Capturar prueba · 10 s" Click="CalibrationCapture_Click" Style="{StaticResource Primary}" IsEnabled="False" Margin="0,4,0,8"/>
              <TextBlock Text="EMISOR · reproducción digital; no confirma recepción" FontWeight="SemiBold"/><Button x:Name="CalibrationEmitButton" Content="Emitir prueba en este equipo" Click="CalibrationEmit_Click" Margin="0,4,0,8"/>
              <TextBlock Text="ALTERNATIVA · analizar archivo existente" FontWeight="SemiBold"/><Button x:Name="CalibrationWavButton" Content="Analizar WAV de prueba…" Click="CalibrationWav_Click" IsEnabled="False" Margin="0,4,0,0"/>
              <TextBlock Text="Captura y WAV requieren referencia previa. El WAV no permite verificar mismo micrófono ni ganancia." Style="{StaticResource Caption}" Margin="0,8,0,0"/>
            </StackPanel></Border>
          </StackPanel></ScrollViewer>
          <ScrollViewer x:Name="CalibrationResultsScroll" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="8,4,8,8">
            <TextBlock Text="04  INTERPRETAR" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Border Style="{StaticResource OperationPanel}"><StackPanel>
              <TextBlock Text="ESTADO DE LA OPERACIÓN" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
              <TextBlock x:Name="CalibrationStateText" Text="Prepare el entorno y capture una referencia de ruido." Foreground="{StaticResource WarningBrush}" FontSize="16" Margin="0,5,0,8"/>
              <Button x:Name="CalibrationCancelButton" Content="Detener / cancelar" Click="CalibrationCancel_Click" IsEnabled="False" Style="{StaticResource Danger}" Margin="0,0,0,7"/>
              <TextBlock x:Name="CalibrationDeviceState" Text="Dispositivo: inactivo" Style="{StaticResource Caption}"/>
            </StackPanel></Border>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource OperationPanel}"><StackPanel><TextBlock Text="REFERENCIA · MICRÓFONO" FontWeight="SemiBold" Foreground="{StaticResource ChannelABrush}"/><TextBlock x:Name="CalibrationNoiseSummary" Text="Pendiente" FontSize="20" Margin="0,5,0,0"/><TextBlock x:Name="CalibrationNoiseMetrics" Text="Sin medición" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel></Border>
              <Border Grid.Column="2" Style="{StaticResource OperationPanel}"><StackPanel><TextBlock x:Name="CalibrationSignalHeading" Text="PRUEBA · PENDIENTE" FontWeight="SemiBold" Foreground="{StaticResource ChannelBBrush}"/><TextBlock x:Name="CalibrationSignalSummary" Text="Pendiente" FontSize="20" Margin="0,5,0,0"/><TextBlock x:Name="CalibrationSignalMetrics" Text="Sin medición" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel></Border>
            </Grid>
            <Expander Header="Mediciones completas · RMS, dBFS, pico, formato y origen" Margin="0,0,0,8"><Border Style="{StaticResource OperationPanel}"><StackPanel><TextBlock Text="REFERENCIA" Foreground="{StaticResource ChannelABrush}" FontWeight="SemiBold"/><TextBlock x:Name="CalibrationNoiseText" Text="No disponible" Margin="0,4,0,12"/><TextBlock Text="PRUEBA" Foreground="{StaticResource ChannelBBrush}" FontWeight="SemiBold"/><TextBlock x:Name="CalibrationSignalText" Text="No disponible" Margin="0,4,0,0"/></StackPanel></Border></Expander>
            <Border Style="{StaticResource OperationPanel}"><StackPanel>
              <TextBlock Text="ENERGÍA POR FRECUENCIA" FontWeight="SemiBold" Margin="0,0,0,5"/>
              <TextBlock Text="Barras: ruido azul / prueba naranja · −60 a 0 dB relativos al máximo de prueba. Números: dB referidos a potencia digital 1; no son dB SPL." Style="{StaticResource Caption}" Margin="0,0,0,8"/>
              <StackPanel x:Name="CalibrationToneRows"/>
            </StackPanel></Border>
            <Border Style="{StaticResource OperationPanel}"><StackPanel><TextBlock Text="LECTURA Y RECOMENDACIONES" FontWeight="SemiBold"/><TextBlock x:Name="CalibrationAdviceText" Text="La calibración caracteriza el canal; la recepción de mensajes requiere validación CRC." Margin="0,6,0,0"/></StackPanel></Border>
          </StackPanel></ScrollViewer>
        </Grid>
      </TabItem>
    </TabControl>
      </ui:NavigationView.ContentOverlay>
    </ui:NavigationView>
    <StatusBar x:Name="WorkspaceStatusBar" Grid.Row="2" Background="#101B2B" Foreground="#AABBD0" Padding="10,2">
      <StatusBarItem><TextBlock x:Name="GeneralStateText" Text="Sin audio seleccionado" FontSize="12"/></StatusBarItem>
      <Separator/><StatusBarItem><TextBlock x:Name="WorkspaceAudioStatusText" Text="Sin fuente de audio" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StatusBarItem>
    </StatusBar>
  </Grid>
</ui:FluentWindow>
