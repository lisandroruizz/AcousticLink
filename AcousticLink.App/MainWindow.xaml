<ui:FluentWindow xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" ExtendsContentIntoTitleBar="True" x:Class="AcousticLink.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:AcousticLink.App" xmlns:visual="clr-namespace:AcousticLink.App.Visualization" mc:Ignorable="d" Title="AcousticLink — Módem acústico BFSK / FDM" Height="740" Width="1180" MinHeight="600" MinWidth="820" Background="{StaticResource PageBrush}" Foreground="#E5EDF7" FontFamily="{StaticResource MainFont}" FontSize="14" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ui:TitleBar x:Name="WindowTitleBar" Title="AcousticLink" Height="36" Background="#101B2B" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="160,0,160,0">
      <TextBlock x:Name="ActiveSectionText" Text="Panel general" FontWeight="SemiBold" />
      <TextBlock Text=" · " Foreground="#8094AF"/><TextBlock Text="{Binding Text, ElementName=GeneralStateText}" FontSize="12" Foreground="#AABBD0"/>
    </StackPanel>
    <ui:NavigationView x:Name="WorkspaceNavigation" Grid.Row="1" Background="{StaticResource PageBrush}" HeaderVisibility="Collapsed" AlwaysShowHeader="False" FrameMargin="0" PaneDisplayMode="Left" IsPaneOpen="True" OpenPaneLength="184" CompactPaneLength="52" IsBackButtonVisible="Collapsed" IsPaneToggleVisible="True">
      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem Content="Panel general" Tag="0" Icon="{ui:SymbolIcon Home24}" Click="Navigation_Click" ToolTip="Panel general"/>
        <ui:NavigationViewItem Content="Emisor" Tag="1" Icon="{ui:SymbolIcon Send24}" Click="Navigation_Click" ToolTip="Emisor"/>
        <ui:NavigationViewItem Content="Receptor" Tag="2" Icon="{ui:SymbolIcon Mic24}" Click="Navigation_Click" ToolTip="Receptor"/>
        <ui:NavigationViewItem Content="Análisis" Tag="3" Icon="{ui:SymbolIcon Search24}" Click="Navigation_Click" ToolTip="Análisis"/>
      </ui:NavigationView.MenuItems>
      <ui:NavigationView.ContentOverlay>
    <TabControl x:Name="MainSectionsTabs" Margin="12,4,12,0" SelectionChanged="WorkspaceSection_Changed" Background="Transparent" BorderThickness="0" SelectedIndex="0">
      <TabControl.RenderTransform><TranslateTransform/></TabControl.RenderTransform>
      <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
      <TabItem Header="Panel general">
       <TabControl x:Name="DashboardTools" Background="Transparent" BorderThickness="0"><TabItem Header="Operaciones"><ScrollViewer x:Name="DashboardOperationScroll" Background="{StaticResource PageBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,8,12,0">
            <TextBlock Text="Centro de operaciones" Style="{StaticResource Heading}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="16" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource OperationPanel}" BorderBrush="{StaticResource ChannelABrush}">
                <StackPanel>
                  <TextBlock Text="CANAL A" Foreground="{StaticResource ChannelABrush}" FontWeight="Bold" />
                  <TextBlock Text="1200 / 1900 Hz · 1–8 bytes UTF-8" Margin="0,4,0,12" />
                  <TextBox Text="{Binding Text, ElementName=FdmTextATextBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=FdmTextATextBox}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource OperationPanel}" BorderBrush="{StaticResource ChannelBBrush}">
                <StackPanel>
                  <TextBlock Text="CANAL B" Foreground="{StaticResource ChannelBBrush}" FontWeight="Bold" />
                  <TextBlock Text="3000 / 3700 Hz · 1–8 bytes UTF-8" Margin="0,4,0,12" />
                  <TextBox Text="{Binding Text, ElementName=FdmTextBTextBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEnabled, ElementName=FdmTextBTextBox}" />
                </StackPanel>
              </Border>
            </Grid>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>            <Border x:Name="DashboardConfiguration" Style="{StaticResource OperationPanel}">
              <StackPanel>
                <TextBlock Text="Configuración de transmisión" FontWeight="SemiBold" />
                <ui:ToggleSwitch Content="Usar Hamming (7,4)" Margin="0,8" IsChecked="{Binding IsChecked, ElementName=UseHammingTransmitCheckBox, Mode=TwoWay}" IsEnabled="{Binding IsEnabled, ElementName=UseHammingTransmitCheckBox}" />
                <TextBlock Text="CRC-32 permanente · 2 canales FDM · 48 kHz · 0,10 s/símbolo" />
                <ComboBox ItemsSource="{Binding ItemsSource, ElementName=FdmProfileComboBox}" SelectedItem="{Binding SelectedItem, ElementName=FdmProfileComboBox, Mode=TwoWay}" IsEnabled="{Binding IsEnabled, ElementName=FdmProfileComboBox}" Margin="0,10" />
                <Expander Header="Composición de las tramas"><TextBlock Text="{Binding Text, ElementName=FdmTextInfoText}" /></Expander><TextBlock Text="{Binding Text, ElementName=TransmitDurationText}" FontSize="20" Margin="0,8,0,0"/>
                <Button Content="Transmitir mensajes" Style="{StaticResource Primary}" Margin="0,14,0,0" Click="TransmitFdmText_Click" IsEnabled="{Binding IsEnabled, ElementName=TransmitFdmTextButton}" />
                <TextBlock Text="{Binding Text, ElementName=FdmTextStatusText}" Margin="0,10,0,0" />
              </StackPanel>
            </Border>
<Border Grid.Column="2" Style="{StaticResource OperationPanel}"><StackPanel><TextBlock Text="{Binding Text, ElementName=ContinuousStatusText}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4"/><TextBlock Text="Señal actual" FontSize="18" FontWeight="SemiBold"/><visual:SignalMiniView x:Name="MiniSignalMonitor" Margin="0,8"/><Button Content="Abrir monitor" Click="OpenSignalMonitor_Click"/></StackPanel></Border></Grid>            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="16" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource OperationPanel}" BorderBrush="{StaticResource ChannelABrush}">
                <StackPanel>
                  <TextBlock Text="RECEPCIÓN A" Foreground="{StaticResource ChannelABrush}" />
                  <TextBlock Text="{Binding SummaryText, ElementName=ReceptionAView}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource OperationPanel}" BorderBrush="{StaticResource ChannelBBrush}">
                <StackPanel>
                  <TextBlock Text="RECEPCIÓN B" Foreground="{StaticResource ChannelBBrush}" />
                  <TextBlock Text="{Binding SummaryText, ElementName=ReceptionBView}" />
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer></TabItem><TabItem Header="Monitor de señales"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><WrapPanel Margin="4,6"><ComboBox x:Name="MonitorSourceComboBox" Width="250" SelectedIndex="0" SelectionChanged="MonitorSource_Changed"><ComboBoxItem Content="Audio seleccionado · micrófono / WAV"/><ComboBoxItem Content="Última señal digital FDM generada"/></ComboBox><Button Content="Analizar / reintentar" Click="AnalyzeMonitor_Click" Margin="8,0"/><Button x:Name="CancelMonitorButton" Content="Cancelar monitor" Click="CancelMonitor_Click" IsEnabled="False"/></WrapPanel><visual:SignalMonitorView x:Name="DashboardSignalMonitor" Grid.Row="1"/></Grid></TabItem></TabControl>
      </TabItem>
      <TabItem Header="Emisor">
        <Grid x:Name="TransmitterWorkspace" Background="{StaticResource PageBrush}">
          <TabControl x:Name="TransmitterTools" Background="Transparent" BorderThickness="0">
            <TabItem Header="Mensajes de texto">
              <Grid x:Name="TransmitPanels" Margin="0,4,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*" MinWidth="260"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="240"/></Grid.ColumnDefinitions>
                <Grid Margin="8,0,16,0">
                  <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                      <TextBlock Text="MENSAJES A TRANSMITIR" FontSize="12" Foreground="#AABBD0" Margin="0,6,0,12"/>
                      <TextBlock Text="Canal A" Foreground="{StaticResource ChannelABrush}" FontSize="20" FontWeight="SemiBold"/>
                      <TextBlock Text="1200 / 1900 Hz" Foreground="#AABBD0"/>
                      <TextBox x:Name="FdmTextATextBox" Text="Hola" Width="420" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" HorizontalAlignment="Left" FontSize="24" Margin="0,8,0,4" TextChanged="FdmText_TextChanged"/>
                      <TextBlock x:Name="TransmitABytesText" Foreground="#AABBD0" FontSize="12"/>
                      <Separator Margin="0,12" Background="{StaticResource LineBrush}"/>
                      <TextBlock Text="Canal B" Foreground="{StaticResource ChannelBBrush}" FontSize="20" FontWeight="SemiBold"/>
                      <TextBlock Text="3000 / 3700 Hz" Foreground="#AABBD0"/>
                      <TextBox x:Name="FdmTextBTextBox" Text="Mundo" Width="420" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" HorizontalAlignment="Left" FontSize="24" Margin="0,8,0,4" TextChanged="FdmText_TextChanged"/>
                      <TextBlock x:Name="TransmitBBytesText" Foreground="#AABBD0" FontSize="12"/>
                      <Border Background="{StaticResource ResultSurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,18,0,0"><StackPanel><TextBlock Text="Vista previa de la señal emitida" FontWeight="SemiBold"/><TextBlock Text="Se conserva el buffer digital realmente preparado para reproducción. No representa una medición acústica." Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,6,0,8"/><Button Content="Preparar vista previa" Click="PrepareSignalPreview_Click" Margin="0,0,0,6"/><Button Content="Explorar última señal generada" Click="OpenGeneratedMonitor_Click"/></StackPanel></Border>
                    </StackPanel>
                  </ScrollViewer>
                  <StackPanel Grid.Row="1" Margin="0,14,0,0">
                    <TextBlock x:Name="TransmitDurationText" FontSize="22" FontWeight="SemiBold"/>
                    <Button x:Name="TransmitFdmTextButton" Content="Transmitir" Style="{StaticResource Primary}" FontSize="18" Padding="32,12" Margin="0,8" Click="TransmitFdmText_Click"/>
                    <TextBlock x:Name="FdmTextStatusText" TextWrapping="Wrap"/>
                  </StackPanel>
                </Grid>
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource LineBrush}" ShowsPreview="True" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Focusable="True"/>
                <Border Grid.Column="2" Background="#101B2B" Padding="16,8">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                    <TextBlock Text="CONFIGURACIÓN FDM" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="Perfil de amplitud"/>
                    <ComboBox x:Name="FdmProfileComboBox" Style="{StaticResource InspectorSelector}" Margin="0,6,0,12"/>
                    <ui:ToggleSwitch x:Name="UseHammingTransmitCheckBox" Content="Usar Hamming (7,4)" IsChecked="False" Checked="HammingTransmit_Changed" Unchecked="HammingTransmit_Changed"/>
                    <TextBlock Text="Seleccionar el mismo modo en el receptor." FontSize="12" Foreground="#AABBD0" Margin="0,6,0,12"/>
                    <Separator Background="{StaticResource LineBrush}"/>
                    <TextBlock Text="TRAMA Y DURACIÓN" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,6"/>
                    <TextBlock x:Name="FdmTextInfoText" TextWrapping="Wrap"/>
                    <Separator Margin="0,12" Background="{StaticResource LineBrush}"/>
                    <TextBlock Text="48 kHz · mono · 0,10 s/símbolo"/>
                    <TextBlock Text="CRC-32 permanente · 1–8 bytes UTF-8 por canal" Foreground="#AABBD0" FontSize="12"/>
                    <TextBlock Text="Cabecera sin Hamming. El relleno FDM queda fuera del CRC y del bloque protegido." Foreground="#AABBD0" FontSize="12" Margin="0,8,0,0"/>
                  </StackPanel></ScrollViewer>
                </Border>
              </Grid>
            </TabItem>
            <TabItem Header="Pruebas técnicas"><TabControl Background="Transparent" BorderThickness="0"><TabItem Header="BFSK · tonos, secuencia y trama"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Padding="12">
                      <StackPanel>
                        <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="Tonos aislados" />
                        <Button x:Name="Bit0Button" Content="Reproducir bit 0 (1200 Hz)" Margin="0,0,0,12" Padding="12" Click="PlayBit0_Click" />
                        <Button x:Name="Bit1Button" Content="Reproducir bit 1 (1900 Hz)" Padding="12" Click="PlayBit1_Click" />
                        <TextBlock Margin="0,24,0,8" FontWeight="SemiBold" Text="Secuencia BFSK" />
                        <TextBox MaxWidth="420" HorizontalAlignment="Left" x:Name="BitSequenceTextBox" Padding="8" Text="10110010" TextChanged="BitSequenceTextBox_TextChanged" />
                        <TextBlock x:Name="SequenceInfoText" Margin="0,6,0,10" Text="8 bits · duración estimada: 0,8 s" />
                        <Button x:Name="PlaySequenceButton" Content="Reproducir secuencia BFSK" Padding="12" Click="PlaySequence_Click" />
                        <TextBlock Margin="0,16,0,8" FontWeight="SemiBold" Text="Trama de prueba · usa el mismo campo de datos (1–16 bits)" />
                        <TextBlock x:Name="FrameInfoText" TextWrapping="Wrap" />
                        <Button x:Name="PlayFrameButton" Content="Reproducir trama de prueba" Padding="12" Margin="0,8,0,0" Click="PlayFrame_Click" />
                        <TextBlock x:Name="StatusText" Margin="0,16,0,0" TextWrapping="Wrap" Text="Tonos de prueba: 1 segundo, amplitud 0,15." />
                      </StackPanel>
                    </Border>
                  </ScrollViewer></TabItem>
<TabItem Header="FDM · tonos"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Padding="12">
                      <StackPanel>
                        <TextBlock Margin="0,24,0,8" FontWeight="SemiBold" Text="Prueba FDM · dos tonos simultáneos · 1 segundo" />
                        <TextBlock Text="Canal A:" />
                        <ComboBox MaxWidth="420" HorizontalAlignment="Left" x:Name="FdmBitAComboBox" SelectedIndex="0" Margin="0,4,0,8">
                          <ComboBoxItem Content="Bit 0 · 1200 Hz" />
                          <ComboBoxItem Content="Bit 1 · 1900 Hz" />
                        </ComboBox>
                        <TextBlock Text="Canal B:" />
                        <ComboBox MaxWidth="420" HorizontalAlignment="Left" x:Name="FdmBitBComboBox" SelectedIndex="0" Margin="0,4,0,8">
                          <ComboBoxItem Content="Bit 0 · 3000 Hz" />
                          <ComboBoxItem Content="Bit 1 · 3700 Hz" />
                        </ComboBox>
                        <TextBlock Text="Amplitudes según perfil · límite teórico conjunto: 0,15 · mono, 48 kHz" TextWrapping="Wrap" />
                        <Button x:Name="PlayFdmButton" Content="Reproducir ambos tonos" Padding="12" Margin="0,8,0,0" Click="PlayFdm_Click" />
                        <TextBlock x:Name="FdmStatusText" TextWrapping="Wrap" Margin="0,8,0,0" />
                      </StackPanel>
                    </Border>
                  </ScrollViewer></TabItem>
<TabItem Header="FDM · secuencias"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Padding="12">
                      <StackPanel>
                        <TextBlock Margin="0,24,0,8" FontWeight="SemiBold" Text="Secuencias FDM simultáneas · igual longitud (1–16 bits)" />
                        <TextBlock Text="Bits del canal A:" />
                        <TextBox MaxWidth="420" HorizontalAlignment="Left" x:Name="FdmSequenceATextBox" Text="10110010" Padding="8" TextChanged="FdmSequences_TextChanged" />
                        <TextBlock Text="Bits del canal B:" Margin="0,8,0,0" />
                        <TextBox MaxWidth="420" HorizontalAlignment="Left" x:Name="FdmSequenceBTextBox" Text="01001101" Padding="8" TextChanged="FdmSequences_TextChanged" />
                        <TextBlock x:Name="FdmSequencesInfoText" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <Button x:Name="PlayFdmSequencesButton" Content="Reproducir ambas secuencias" Padding="12" Margin="0,8,0,0" Click="PlayFdmSequences_Click" />
                        <TextBlock x:Name="FdmSequencesStatusText" TextWrapping="Wrap" Margin="0,8,0,0" />
                      </StackPanel>
                    </Border>
                  </ScrollViewer></TabItem>
<TabItem Header="FDM · tramas"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Padding="12">
                      <StackPanel>
                        <TextBlock Margin="0,24,0,8" FontWeight="SemiBold" Text="Tramas FDM simultáneas · datos de igual longitud (1–16 bits)" />
                        <TextBlock Text="Datos A:" />
                        <TextBox MaxWidth="420" HorizontalAlignment="Left" x:Name="FdmFrameATextBox" Text="10110010" Padding="8" TextChanged="FdmFrames_TextChanged" />
                        <TextBlock Text="Datos B:" Margin="0,8,0,0" />
                        <TextBox MaxWidth="420" HorizontalAlignment="Left" x:Name="FdmFrameBTextBox" Text="01001101" Padding="8" TextChanged="FdmFrames_TextChanged" />
                        <TextBlock x:Name="FdmFramesInfoText" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <Button x:Name="PlayFdmFramesButton" Content="Reproducir ambas tramas" Padding="12" Margin="0,8,0,0" Click="PlayFdmFrames_Click" />
                        <TextBlock x:Name="FdmFramesStatusText" TextWrapping="Wrap" Margin="0,8,0,0" />
                      </StackPanel>
                    </Border>
                  </ScrollViewer></TabItem></TabControl></TabItem>
            <TabItem Header="Señal generada"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><WrapPanel Margin="4,6"><TextBlock Text="Último buffer FDM preparado · no es recepción acústica" VerticalAlignment="Center"/><Button Content="Recalcular monitor" Click="RetryGeneratedMonitor_Click" Margin="8,0"/><Button Content="Cancelar monitor" Click="CancelGeneratedMonitor_Click"/></WrapPanel><visual:SignalMonitorView x:Name="GeneratedSignalMonitor" Grid.Row="1"/></Grid></TabItem>
          </TabControl>
        </Grid>
      </TabItem>
      <TabItem Header="Receptor">
<Grid x:Name="ReceiverWorkspace" SizeChanged="ReceiverWorkspace_SizeChanged" Background="{StaticResource PageBrush}">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <WrapPanel Margin="0,4,0,8">
  <Button x:Name="ContinuousListenButton" Content="Iniciar escucha continua" Click="ContinuousListen_Click" Padding="10,6" Margin="0,0,8,0"/>
  <TextBlock x:Name="ContinuousOperationalText" Text="Micrófono apagado · escucha detenida" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Estado de la sesión actual. La preferencia de inicio automático se configura por separado."/>
  <Button x:Name="StartCaptureButton" Content="● Capturar" Padding="12,6" Margin="0,0,4,0" Click="StartCapture_Click"/>
  <Button x:Name="StopCaptureButton" Style="{StaticResource Danger}" Content="■ Detener" IsEnabled="False" Padding="12,6" Margin="0,0,8,0" Click="StopCapture_Click"/>
  <ComboBox x:Name="CaptureDurationComboBox" Style="{StaticResource InspectorSelector}" SelectedIndex="0" Width="90" Margin="0,0,12,0"><ComboBoxItem Content="10 s" Tag="10"/><ComboBoxItem Content="20 s" Tag="20"/><ComboBoxItem Content="30 s" Tag="30"/></ComboBox>
  <Button x:Name="LoadWavButton"  Padding="12,6" Margin="0,0,4,0" Click="LoadWav_Click" AutomationProperties.Name="Abrir WAV" ToolTip="Importa una grabación sin modificar las muestras. Si falla, se conserva el audio anterior."><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" Margin="0,0,6,0"/><TextBlock Text="Abrir WAV"/></StackPanel></Button>
  <Button x:Name="SaveCaptureButton"  IsEnabled="False" Padding="12,6" Margin="0,0,12,0" Click="SaveCapture_Click" AutomationProperties.Name="Guardar WAV" ToolTip="Guarda las muestras reales seleccionadas con su frecuencia de muestreo."><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Save24" FontSize="16" Margin="0,0,6,0"/><TextBlock Text="Guardar WAV"/></StackPanel></Button>
  <Button x:Name="ReceiveFdmTextButton"  IsEnabled="False" Style="{StaticResource Primary}" Padding="12,6" Margin="0,0,4,0" Click="ReceiveFdmText_Click" AutomationProperties.Name="Recibir mensajes" ToolTip="Analiza la grabación finalizada. No realiza recepción continua en tiempo real."><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Search24" FontSize="16" Margin="0,0,6,0"/><TextBlock Text="Recibir mensajes"/></StackPanel></Button>
  <Button x:Name="CancelReceiveFdmTextButton" Content="Cancelar" IsEnabled="False" Padding="12,6" Margin="0,0,8,0" Click="CancelReceiveFdmText_Click"/>
  <ToggleButton x:Name="ReceiverInspectorToggle" Content="☷" FontSize="18" Width="38" ToolTip="Mostrar u ocultar el inspector de recepción" AutomationProperties.Name="Inspector de recepción" IsChecked="True" Tag="Reception" Click="WorkspacePanel_Click" Padding="10,6" MinHeight="38"/>
 </WrapPanel>
 <Grid Grid.Row="1">
  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6" x:Name="ReceiverDividerColumn"/><ColumnDefinition x:Name="ReceiverInspectorColumn" Width="280" MinWidth="240" MaxWidth="480"/></Grid.ColumnDefinitions>
  <TabControl x:Name="ReceiverTools" ItemContainerStyle="{StaticResource WorkspaceToolTab}" Background="Transparent" BorderThickness="0" SelectionChanged="InternalTool_Changed">
   <TabItem Header="Mensajes"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,6,8,0"><Button Content="Abrir señal y detección" Click="OpenReceptionSignal_Click" HorizontalAlignment="Left" Margin="0,0,0,12"/><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="CANAL A" Foreground="{StaticResource ChannelABrush}" FontWeight="SemiBold"/><visual:ReceptionView x:Name="ReceptionAView"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="CANAL B" Foreground="{StaticResource ChannelBBrush}" FontWeight="SemiBold"/><visual:ReceptionView x:Name="ReceptionBView"/></StackPanel>
    </Grid><Expander x:Name="CaptureInstrumentationDetails" Header="Instrumentación de captura · detalles" Margin="0,12,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel><ComboBox x:Name="WaveformScaleComboBox" Style="{StaticResource InspectorSelector}" DockPanel.Dock="Right" SelectedIndex="1" Width="185" SelectionChanged="WaveformScale_Changed"><ComboBoxItem Content="Escala original ±1"/><ComboBoxItem Content="Ajustar visualización"/></ComboBox><StackPanel><TextBlock x:Name="WaveformInfoText" Text="Sin señal disponible" FontSize="13" Foreground="#AABBD0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="WaveformScaleText" Text="Ajuste solo visual · no modifica las muestras" FontSize="13" Foreground="#AABBD0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel></DockPanel>
      <visual:WaveformView x:Name="ReceivedWaveform" Height="180" Grid.Row="1" Margin="0,6" MinHeight="180"/>

    </Grid></Expander></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Explorador de trama"><visual:FrameExplorerView x:Name="ReceivedFrameExplorer" FitWorkspace="True"/></TabItem><TabItem Header="Monitor de recepción"><visual:SignalMonitorView x:Name="ReceiverSignalMonitor" ReceiverMode="True"/></TabItem>
  </TabControl>
  <GridSplitter x:Name="ReceiverInspectorSplitter" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource LineBrush}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" Focusable="True"/>
  <Border x:Name="ReceiverInspector" Grid.Column="2" Background="#101B2B" Padding="10,4"><TabControl x:Name="ReceiverInspectorTabs" ItemContainerStyle="{StaticResource WorkspaceToolTab}" Background="Transparent" BorderThickness="0" SelectionChanged="InternalTool_Changed">
   <TabItem Header="Opciones"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <CheckBox x:Name="AutoListenCheckBox" Content="Activar escucha continua al iniciar AcousticLink" Click="AutoListen_Click" Margin="0,4,0,8"/>
    <TextBlock x:Name="ContinuousStatusText" Text="Escucha continua desactivada" TextWrapping="Wrap" Margin="0,4"/>
    <ComboBox x:Name="ContinuousHistoryComboBox" DisplayMemberPath="Label" SelectionChanged="ContinuousHistory_Changed" ToolTip="Historial acotado; seleccionar no detiene la escucha"/>
    <Button Content="Volver a la escucha en vivo" Click="ContinuousLive_Click" Margin="0,4,0,10"/>
    <TextBlock Text="RECEPCIÓN" Style="{StaticResource InspectorHeading}"/>
    <ui:ToggleSwitch x:Name="DecodeDuringCaptureCheckBox" Content="Decodificar durante la captura" IsChecked="False" ToolTip="Busca una transmisión FDM y procesa símbolos completos usando solo las muestras ya capturadas. Las opciones quedan fijadas al iniciar."/>
    <ui:ToggleSwitch x:Name="UseHammingReceiveCheckBox" ToolTip="Debe coincidir con el modo elegido en el emisor. Hamming no protege la cabecera." Content="Usar Hamming (7,4)" IsChecked="False"/>
    <ui:ToggleSwitch x:Name="RecoverReceiveErasuresCheckBox" ToolTip="Intenta reconstruir uno o dos símbolos ? por palabra usando solo la redundancia Hamming; el CRC verifica el bloque final." Content="Recuperar borrados (?)" IsChecked="False" IsEnabled="False" Margin="0,6"/>
    <TextBlock Text="Seleccionar el mismo modo que el emisor. El CRC valida la integridad final." FontSize="12" Foreground="#AABBD0"/>
    <Separator Margin="0,10"/><TextBlock Text="ESTADO DE RECEPCIÓN" Style="{StaticResource InspectorHeading}"/>
    <visual:ReceptionProgressView x:Name="LiveReceptionInspector"/>
