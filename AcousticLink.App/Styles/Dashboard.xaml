<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PageBrush" Color="#0B1220" />
    <SolidColorBrush x:Key="CardBrush" Color="#141F32" />
    <SolidColorBrush x:Key="LineBrush" Color="#2B3C54" />
    <SolidColorBrush x:Key="ChannelABrush" Color="#69B7FF" />
    <SolidColorBrush x:Key="ChannelBBrush" Color="#FFB36B" />
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="#E5EDF7" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="22" />
    </Style>
    <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="22" /><Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" /><Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="#E5EDF7" /><Setter Property="Background" Value="#243650" />
        <Setter Property="BorderBrush" Value="#3C5371" /><Setter Property="Padding" Value="16,10" />
        <Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="MinHeight" Value="38" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.8" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#69B7FF" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.4" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#16774F" /><Setter Property="BorderBrush" Value="#43C58C" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#0B1525" /><Setter Property="Foreground" Value="#E5EDF7" />
        <Setter Property="CaretBrush" Value="White" /><Setter Property="BorderBrush" Value="#455A76" />
        <Setter Property="Padding" Value="10" /><Setter Property="MinHeight" Value="38" />
        <Setter Property="SelectionBrush" Value="#286BA1" />
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E5EDF7" /><Setter Property="Padding" Value="4" /></Style>
    <Style TargetType="Expander"><Setter Property="Foreground" Value="#E5EDF7" /><Setter Property="Margin" Value="0,0,0,12" /></Style>
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="#AABBD0" /><Setter Property="Background" Value="Transparent" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
            <Border x:Name="Tab" Background="{TemplateBinding Background}" CornerRadius="7" Padding="18,12" Margin="0,0,8,12">
                <ContentPresenter ContentSource="Header" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="White" /><Setter TargetName="Tab" Property="Background" Value="#243C5B" /></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="#69B7FF" /><Setter TargetName="Tab" Property="BorderThickness" Value="1" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="#69B7FF" /><Setter TargetName="Tab" Property="BorderThickness" Value="1" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
